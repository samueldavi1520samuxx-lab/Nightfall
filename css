* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    background: #080d12;
    color: white;
    font-family: Arial, sans-serif;
    overflow: hidden;
}

#game {
    width: 100vw;
    height: 100dvh;
    position: relative;
}

canvas {
    display: block;
    width: 100%;
    height: 100%;
}

#loading, #menu {
    position: absolute;
    inset: 0;
    z-index: 5;
    background: #080d12;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 20px;
    text-align: center;
}

#loading[hidden], #menu[hidden], #hud[hidden] {
    display: none;
}

h1 {
    color: #a7d5b1;
    letter-spacing: 5px;
}

button {
    background: #315d42;
    color: white;
    border: 1px solid #8eb99a;
    padding: 14px 24px;
    border-radius: 8px;
    cursor: pointer;
    font-weight: bold;
}

button:hover {
    background: #477c58;
}

#hud {
    position: absolute;
    inset: 15px 15px auto;
    z-index: 3;
    display: flex;
    justify-content: space-between;
    align-items: center;
    pointer-events: none;
}

#hud button {
    pointer-events: auto;
}

#status {
    position: absolute;
    top: 55px;
    right: 0;
    color: #b6d9bd;
}

#mobileControls {
    position: absolute;
    bottom: 35px;
    left: 30px;
}

#joystick {
    width: 75px;
    height: 75px;
    border: 2px solid #ffffff88;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: #ffffff22;
    touch-action: none;
}

@media (max-width: 700px) {
    h1 {
        font-size: 23px;
    }
}
